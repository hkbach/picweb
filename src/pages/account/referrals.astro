---
import AccountLayout from '../../layouts/AccountLayout.astro';
import { referralSummary } from '../../server/credits.ts';
import { CLAIM_LABELS, claimable, listClaimsOf, usd } from '../../server/claims.ts';

export const prerender = false;

const user = Astro.locals.user!;
const summary = referralSummary(user.id);
const { settings } = summary;
const claims = listClaimsOf(user.id);
const rate = settings.creditsPerUsd;
const { dollars } = claimable(summary.balance, rate);
const link = `${Astro.url.origin}/?ref=${summary.code}`;
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const REASONS = {
	signup: 'Welcome credits for registering',
	referral_signup: 'A friend registered with your link',
	referral_albums: 'A friend opened albums',
	claim: 'Credits claimed through PayPal',
	claim_refund: 'A claim was rejected: credits returned',
	admin_grant: 'Credits added by an administrator',
} as const;
const when = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<AccountLayout title="Referrals" heading="Referrals">
	<section class="balance" aria-labelledby="balance-title" data-rate={rate} data-balance={summary.balance}>
		<h2 id="balance-title">Your credits</h2>
		<p class="amount" id="balance">{summary.balance.toLocaleString('en-US')}</p>
		<p class="worth" id="worth">Worth ${(summary.balance / rate).toFixed(2)} ({rate.toLocaleString('en-US')} credits = 1 USD)</p>
		<div class="claim-row">
			<button type="button" id="claim-btn" class="claim" aria-disabled={dollars < 1 ? 'true' : undefined} aria-describedby="claim-hint">
				{dollars < 1 ? 'Claim' : `Claim $${dollars}`}
			</button>
			<p class="hint" id="claim-hint">
				{dollars < 1 ? `You need ${rate.toLocaleString('en-US')} credits to claim 1 USD. You have ${summary.balance.toLocaleString('en-US')}.` : `Cash out ${(dollars * rate).toLocaleString('en-US')} credits through PayPal.`}
			</p>
		</div>
		<p class="claimed" id="claim-done" role="status"></p>
	</section>

	<section class="share" aria-labelledby="share-title">
		<h2 id="share-title">Invite friends</h2>
		<p class="lead">Share your link. When a friend registers through it, you earn credits as they enjoy Picweb.</p>
		<div class="link-row">
			<input id="ref-link" type="text" readonly value={link} aria-label="Your invitation link" />
			<button type="button" id="copy-link" class="copy">Copy link</button>
		</div>
		<p class="copied" id="copied" role="status"></p>
		<ul class="rules">
			<li>You got <strong>{plural(settings.signup, 'credit')}</strong> for registering.</li>
			<li>A friend registers through your link: <strong>{plural(settings.referralSignup, 'credit')}</strong> for you.</li>
			<li>
				Each time that friend has opened <strong>{plural(settings.albumsPerCredit, 'different album')}</strong> to look at the photos: <strong>{plural(settings.referralAlbums, 'credit')}</strong> for you.
			</li>
			<li>
				<strong>{plural(rate, 'credit')} = 1 USD</strong>. Claims are paid through PayPal in whole dollars.
			</li>
		</ul>
	</section>

	<section aria-labelledby="claims-title" class="claims">
		<h2 id="claims-title">Your claims</h2>
		<p class="none" id="claims-none" hidden={claims.length > 0}>You have not claimed any credits yet.</p>
		<div class="table-wrap" id="claims-wrap" hidden={claims.length === 0}>
			<table>
				<caption class="visually-hidden">Your claims, newest first</caption>
				<thead>
					<tr>
						<th scope="col">Date</th>
						<th scope="col" class="num">Credits</th>
						<th scope="col" class="num">Amount</th>
						<th scope="col">PayPal</th>
						<th scope="col">Status</th>
					</tr>
				</thead>
				<tbody id="claim-rows">
					{
						claims.map((c) => (
							<tr data-claim-id={c.id}>
								<td class="when">{when(c.createdAt)}</td>
								<td class="num">{c.credits.toLocaleString('en-US')}</td>
								<td class="num">{usd(c.usdCents)}</td>
								<td class="paypal">{c.paypal}</td>
								<td>
									<span class={`badge b-${c.status}`}>{CLAIM_LABELS[c.status]}</span>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>

	<section aria-labelledby="friends-title">
		<h2 id="friends-title">Your friends</h2>
		{
			summary.friends.length === 0 ? (
				<p class="none" id="friends-none">No one has registered through your link yet.</p>
			) : (
				<div class="table-wrap">
					<table id="friends">
						<caption class="visually-hidden">Accounts that registered through your link, newest first</caption>
						<thead>
							<tr>
								<th scope="col">Account</th>
								<th scope="col">Joined</th>
								<th scope="col" class="num">Albums opened</th>
								<th scope="col" class="num">Credits you earned</th>
							</tr>
						</thead>
						<tbody>
							{summary.friends.map((f) => (
								<tr>
									<th scope="row" class="acct">
										<span class="fname">{f.name}</span>
										<span class="femail">{f.email}</span>
									</th>
									<td class="when">{when(f.joinedAt)}</td>
									<td class="num">
										{f.opened}
										<span class="next">{settings.albumsPerCredit - (f.opened % settings.albumsPerCredit)} more for the next credit</span>
									</td>
									<td class="num earned">{f.earned.toLocaleString('en-US')}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p class="count" id="friends-count">
					{plural(summary.friendCount, 'account')} registered through your link{summary.friendCount > summary.friends.length ? ` (the latest ${summary.friends.length} are listed)` : ''}.
				</p>
			)
		}
		<p class="privacy">For privacy, each account is shown by first name and last initial, and its email with the middle hidden.</p>
	</section>

	<section aria-labelledby="history-title">
		<h2 id="history-title">History</h2>
		{
			summary.history.length === 0 ? (
				<p class="none" id="history-none">No credits yet.</p>
			) : (
				<ul class="history" id="history">
					{summary.history.map((h) => (
						<li>
							<span class="date">{when(h.at)}</span>
							<span class="what">{REASONS[h.reason]}</span>
							<span class={h.amount < 0 ? 'minus' : 'plus'}>{h.amount > 0 ? '+' : ''}{h.amount.toLocaleString('en-US')}</span>
						</li>
					))}
				</ul>
			)
		}
	</section>

	<dialog id="claim-dialog" class="dialog" aria-labelledby="claim-title" aria-describedby="claim-text">
		<h2 id="claim-title">Claim through PayPal</h2>
		<p class="dialog-text" id="claim-text"></p>
		<form id="claim-form" novalidate>
			<label for="paypal">Your PayPal email address</label>
			<input id="paypal" name="paypal" type="email" inputmode="email" autocomplete="email" maxlength="254" placeholder="you@example.com" spellcheck="false" aria-describedby="claim-error" />
			<p class="dialog-note">The money is sent to this address by hand, so check it carefully. It is shown to you and to the administrators only.</p>
			<p class="dialog-error" id="claim-error" role="alert"></p>
			<div class="dialog-actions">
				<button type="button" class="dialog-btn ghost" id="claim-cancel">Cancel</button>
				<button type="submit" class="dialog-btn primary" id="claim-submit">Submit claim</button>
			</div>
		</form>
	</dialog>
</AccountLayout>

<script>
	const field = document.querySelector<HTMLInputElement>('#ref-link');
	const status = document.querySelector<HTMLElement>('#copied');
	document.querySelector('#copy-link')?.addEventListener('click', async () => {
		if (!field || !status) return;
		try {
			await navigator.clipboard.writeText(field.value);
			status.textContent = 'Link copied.';
		} catch {
			// no clipboard permission: select it so it can be copied by hand
			field.focus();
			field.select();
			status.textContent = 'Press Ctrl+C to copy the selected link.';
		}
	});
	field?.addEventListener('focus', () => field.select());

	// ---- Claim: the button is shown from the start but does nothing until the balance is worth at least 1 USD
	const box = document.querySelector<HTMLElement>('.balance')!;
	const rate = Number(box.dataset.rate);
	let balance = Number(box.dataset.balance);
	const claimButton = document.querySelector<HTMLButtonElement>('#claim-btn')!;
	const claimHint = document.querySelector<HTMLElement>('#claim-hint')!;
	const dialog = document.querySelector<HTMLDialogElement>('#claim-dialog')!;
	const form = document.querySelector<HTMLFormElement>('#claim-form')!;
	const paypal = document.querySelector<HTMLInputElement>('#paypal')!;
	const errorLine = document.querySelector<HTMLElement>('#claim-error')!;
	const submit = document.querySelector<HTMLButtonElement>('#claim-submit')!;
	const done = document.querySelector<HTMLElement>('#claim-done')!;
	const number = new Intl.NumberFormat('en-US');
	const dollars = () => Math.floor(balance / rate);

	const paintBalance = () => {
		document.querySelector('#balance')!.textContent = number.format(balance);
		document.querySelector('#worth')!.textContent = `Worth $${(balance / rate).toFixed(2)} (${number.format(rate)} credits = 1 USD)`;
		const d = dollars();
		claimButton.textContent = d < 1 ? 'Claim' : `Claim $${d}`;
		claimButton.toggleAttribute('aria-disabled', d < 1);
		if (d < 1) claimButton.setAttribute('aria-disabled', 'true');
		claimHint.textContent = d < 1 ? `You need ${number.format(rate)} credits to claim 1 USD. You have ${number.format(balance)}.` : `Cash out ${number.format(d * rate)} credits through PayPal.`;
	};

	claimButton.addEventListener('click', () => {
		if (claimButton.getAttribute('aria-disabled') === 'true') return;
		const d = dollars();
		document.querySelector('#claim-text')!.textContent = `You will claim $${d}.00 for ${number.format(d * rate)} credits${balance - d * rate > 0 ? `; the other ${number.format(balance - d * rate)} stay in your balance` : ''}. The credits leave your balance now.`;
		errorLine.textContent = '';
		paypal.removeAttribute('aria-invalid');
		dialog.showModal();
		paypal.focus();
	});
	document.querySelector('#claim-cancel')!.addEventListener('click', () => dialog.close());
	dialog.addEventListener('click', (e) => {
		if (e.target === dialog) dialog.close();
	});
	paypal.addEventListener('input', () => {
		errorLine.textContent = '';
		paypal.removeAttribute('aria-invalid');
	});

	// Rows are built with text only: the address is typed by a person.
	const row = (c: { id: number; credits: number; usdCents: number; paypal: string; status: string; createdAt: string }) => {
		const tr = document.createElement('tr');
		tr.dataset.claimId = String(c.id);
		const cell = (text: string, className = '') => {
			const td = document.createElement('td');
			td.className = className;
			td.textContent = text;
			return td;
		};
		const state = document.createElement('td');
		const badge = document.createElement('span');
		badge.className = `badge b-${c.status}`;
		badge.textContent = { processing: 'Processing', paid: 'Paid', rejected: 'Rejected' }[c.status] ?? c.status;
		state.append(badge);
		tr.append(
			cell(new Date(c.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }), 'when'),
			cell(number.format(c.credits), 'num'),
			cell(`$${(c.usdCents / 100).toFixed(2)}`, 'num'),
			cell(c.paypal, 'paypal'),
			state,
		);
		return tr;
	};

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		const address = paypal.value.trim();
		if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(address)) {
			errorLine.textContent = 'Enter the email address of your PayPal account.';
			paypal.setAttribute('aria-invalid', 'true');
			paypal.focus();
			return;
		}
		submit.disabled = true;
		try {
			const response = await fetch('/api/account/claims', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				credentials: 'same-origin',
				body: JSON.stringify({ paypal: address }),
			});
			const data = await response.json().catch(() => null);
			if (!response.ok) {
				errorLine.textContent = typeof data?.error === 'string' ? data.error : 'The claim could not be made. Nothing was changed.';
				if (response.status === 400) paypal.setAttribute('aria-invalid', 'true');
				return;
			}
			balance = data.balance;
			document.querySelector('#claim-rows')!.replaceChildren(...data.claims.map(row));
			document.querySelector<HTMLElement>('#claims-wrap')!.hidden = false;
			document.querySelector<HTMLElement>('#claims-none')!.hidden = true;
			paintBalance();
			dialog.close();
			paypal.value = '';
			done.textContent = `Claim submitted: $${(data.claim.usdCents / 100).toFixed(2)} (${number.format(data.claim.credits)} credits) is Processing.`;
			claimButton.focus();
		} catch {
			errorLine.textContent = 'The server could not be reached. Nothing was changed.';
		} finally {
			submit.disabled = false;
		}
	});
</script>

<style>
	section {
		max-width: 640px;
		margin: 0 0 28px;
	}
	h2 {
		margin: 0 0 8px;
		font-size: 17px;
	}
	.balance {
		padding: 16px 20px;
		border: 1px solid var(--border);
		border-radius: 12px;
	}
	.amount {
		margin: 0;
		font-size: 36px;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}
	.worth {
		margin: 2px 0 14px;
		font-size: 13px;
		color: var(--muted);
	}
	.claim-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 14px;
	}
	.claim {
		height: 44px;
		padding: 0 28px;
		border: 0;
		border-radius: 999px;
		background: var(--text);
		color: #fff;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	/* Shown from the start, but read-only until the balance is worth at least 1 USD. */
	.claim[aria-disabled='true'] {
		background: var(--bg-soft);
		color: var(--muted);
		cursor: not-allowed;
	}
	.claim:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 2px;
	}
	.hint {
		margin: 0;
		font-size: 13px;
		color: var(--muted);
	}
	.claimed {
		min-height: 1.3em;
		margin: 10px 0 0;
		font-size: 13px;
		color: #1b6b34;
	}
	.lead {
		margin: 0 0 12px;
		font-size: 14px;
		color: var(--muted);
	}
	.link-row {
		display: flex;
		gap: 8px;
	}
	#ref-link {
		flex: 1;
		min-width: 0;
		height: 44px;
		padding: 0 12px;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--bg-soft);
		font: inherit;
		font-size: 14px;
	}
	.copy {
		height: 44px;
		padding: 0 20px;
		border: 0;
		border-radius: 999px;
		background: var(--text);
		color: #fff;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.copy:focus-visible,
	#ref-link:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 2px;
	}
	.copied {
		min-height: 1.3em;
		margin: 6px 0 0;
		font-size: 13px;
		color: #1b6b34;
	}
	.rules {
		margin: 8px 0 0;
		padding-left: 18px;
		font-size: 14px;
		color: var(--muted);
	}
	.rules strong {
		color: var(--text);
	}
	.rules li + li {
		margin-top: 4px;
	}
	.none,
	.privacy {
		margin: 0;
		font-size: 14px;
		color: var(--muted);
	}
	.none[hidden],
	.table-wrap[hidden] {
		display: none;
	}
	.privacy {
		margin-top: 8px;
		font-size: 12px;
	}

	/* The claims table: rows are also made by the script, so their cells need :global. */
	.table-wrap {
		overflow-x: auto;
		border: 1px solid var(--border);
		border-radius: 12px;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 14px;
	}
	th,
	td,
	.claims :global(td) {
		padding: 10px 14px;
		text-align: left;
		vertical-align: middle;
	}
	thead th {
		background: #fafafa;
		border-bottom: 1px solid var(--border);
		color: var(--muted);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		white-space: nowrap;
	}
	tbody tr + tr > *,
	.claims :global(tbody tr + tr > *) {
		border-top: 1px solid var(--bg-soft);
	}
	.claims :global(.num),
	.num {
		text-align: right;
		font-variant-numeric: tabular-nums;
	}
	.when,
	.claims :global(.when) {
		color: var(--muted);
		white-space: nowrap;
	}
	.claims :global(.paypal) {
		overflow-wrap: anywhere;
	}
	.claims :global(.badge) {
		display: inline-block;
		padding: 3px 10px;
		border-radius: 999px;
		background: #fff4d6;
		color: #8a5a00;
		font-size: 12px;
		font-weight: 600;
		white-space: nowrap;
	}
	.claims :global(.b-paid) {
		background: #e6f4ea;
		color: #1b6b34;
	}
	.claims :global(.b-rejected) {
		background: #fde8e8;
		color: #c62828;
	}

	.history {
		margin: 0;
		padding: 0;
		list-style: none;
		border: 1px solid var(--border);
		border-radius: 12px;
	}
	.history li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 12px;
		padding: 10px 16px;
		font-size: 14px;
	}
	.history li + li {
		border-top: 1px solid var(--bg-soft);
	}
	/* Accounts that registered through the link. */
	.acct {
		font-weight: 400;
	}
	.fname,
	.femail,
	.next {
		display: block;
	}
	.fname {
		font-weight: 600;
	}
	.femail,
	.next,
	.count {
		font-size: 12px;
		color: var(--muted);
	}
	.next {
		font-weight: 400;
	}
	.earned {
		font-weight: 700;
		color: #1b6b34;
	}
	.count {
		margin: 8px 0 0;
	}
	.date {
		color: var(--muted);
	}
	.history .what {
		flex: 1;
		min-width: 140px;
	}
	.plus,
	.minus {
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}
	.plus {
		color: #1b6b34;
	}
	.minus {
		color: #c62828;
	}

	/* The PayPal popup, in the same style as the other dialogs. */
	.dialog {
		width: min(440px, calc(100vw - 32px));
		padding: 28px;
		border: 0;
		border-radius: 12px;
		color: var(--text);
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
		opacity: 0;
		transform: translateY(16px) scale(0.96);
		transition:
			opacity 0.25s ease,
			transform 0.25s ease,
			overlay 0.25s allow-discrete,
			display 0.25s allow-discrete;
	}
	.dialog[open] {
		opacity: 1;
		transform: none;
	}
	.dialog::backdrop {
		background: rgba(0, 0, 0, 0);
		transition:
			background 0.25s ease,
			overlay 0.25s allow-discrete,
			display 0.25s allow-discrete;
	}
	.dialog[open]::backdrop {
		background: rgba(0, 0, 0, 0.6);
	}
	@starting-style {
		.dialog[open] {
			opacity: 0;
			transform: translateY(16px) scale(0.96);
		}
		.dialog[open]::backdrop {
			background: rgba(0, 0, 0, 0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.dialog,
		.dialog::backdrop {
			transition: none;
		}
	}
	.dialog h2 {
		margin: 0 0 12px;
		font-size: 20px;
	}
	.dialog-text {
		margin: 0 0 14px;
		font-size: 15px;
	}
	.dialog label {
		display: block;
		margin-bottom: 6px;
		font-size: 14px;
		font-weight: 500;
	}
	.dialog input {
		width: 100%;
		height: 46px;
		padding: 0 14px;
		border: 1px solid var(--border);
		border-radius: 10px;
		font: inherit;
	}
	.dialog input:focus {
		outline: 0;
		border-color: var(--text);
		box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.08);
	}
	.dialog input[aria-invalid='true'] {
		border-color: #c62828;
	}
	.dialog-note {
		margin: 8px 0 0;
		font-size: 12px;
		color: var(--muted);
	}
	.dialog-error {
		min-height: 1.2em;
		margin: 6px 0 0;
		font-size: 13px;
		color: #c62828;
	}
	.dialog-actions {
		display: flex;
		justify-content: flex-end;
		gap: 8px;
		margin-top: 12px;
	}
	.dialog-btn {
		height: 44px;
		padding: 0 24px;
		border-radius: 999px;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.dialog-btn:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 2px;
	}
	.dialog-btn.primary {
		border: 0;
		background: var(--text);
		color: #fff;
	}
	.dialog-btn.primary:disabled {
		opacity: 0.6;
		cursor: default;
	}
	.dialog-btn.ghost {
		border: 0;
		background: none;
		color: var(--muted);
	}
	.dialog-btn.ghost:hover {
		background: var(--bg-soft);
		color: var(--text);
	}
</style>
