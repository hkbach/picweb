---
import AccountLayout from '../../layouts/AccountLayout.astro';
import PhotoTiles from '../../components/PhotoTiles.astro';
import { listLiked } from '../../server/repo.ts';

export const prerender = false;
const likedPhotos = listLiked(Astro.locals.user!.id);
---

<AccountLayout title="Liked photos" heading="Liked photos">
	<PhotoTiles photos={likedPhotos} empty="You haven't liked any photos yet." paginate />
</AccountLayout>
