---
import AccountLayout from '../../layouts/AccountLayout.astro';
import PhotoTiles from '../../components/PhotoTiles.astro';
import { listFavorites } from '../../server/repo.ts';

export const prerender = false;
const favoritePhotos = listFavorites(Astro.locals.user!.id);
---

<AccountLayout title="Favorites" heading="Favorites">
	<PhotoTiles photos={favoritePhotos} empty="You haven't added any favorites yet." />
</AccountLayout>
