---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { albumTypeLabels, listAlbums, listCategories } from '../../../server/repo.ts';
import { facebookExpiry, formatExpiry } from '../../../scripts/facebook-expiry.ts';

const albums = listAlbums();
const categories = listCategories();

// An album made from links to Facebook pictures stops showing them when those addresses expire.
const expiryOf = (photos: Array<{ src: string }>) => {
	const times = photos.map((p) => facebookExpiry(p.src)).filter((t): t is number => t !== null);
	return times.length > 0 ? Math.min(...times) : null;
};
const now = Date.now();
const deactivated = albums.filter((a) => a.status === 'deactivated').length;

// Category names for an album, in the album's own order. An id that no longer exists is skipped.
const categoryName = new Map(categories.map((c) => [c.id, c.name]));
const namesOf = (ids: string[]) => ids.map((id) => categoryName.get(id)).filter((name): name is string => Boolean(name));

// The time is written in UTC here; the script at the bottom of the page shows it in the viewer's own time zone.
const createdText = (iso: string) => `${new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC' })} UTC`;

// Rendered on demand so the middleware can require an administrator before anything is sent.
export const prerender = false;
---

<AdminLayout title="Albums" heading="Albums">
	<div class="toolbar">
		<p class="summary">
			<span id="album-count">{albums.length} album{albums.length === 1 ? '' : 's'}</span><span id="album-count-off">{deactivated > 0 ? ` · ${deactivated} deactivated` : ''}</span>
		</p>
		<a href="/admin/albums/new" class="btn" id="create-link">Create new album</a>
	</div>

	<p class="status" id="list-status" role="status" tabindex="-1"></p>

	{
		albums.length === 0 ? (
			<p class="empty" id="empty">No albums yet. Create the first one.</p>
		) : (
			<>
			<form class="filters" id="album-filters" role="search" aria-label="Search and filter albums" autocomplete="off">
				<div class="field field-search">
					<label for="f-search">Search title</label>
					<input type="search" id="f-search" placeholder="Title contains…" maxlength="200" />
				</div>
				<div class="field">
					<label for="f-type">Type</label>
					<select id="f-type">
						<option value="">All types</option>
						<option value="crawling">{albumTypeLabels.crawling}</option>
						<option value="uploaded">{albumTypeLabels.uploaded}</option>
					</select>
				</div>
				<div class="field">
					<label for="f-status">Status</label>
					<select id="f-status">
						<option value="">All statuses</option>
						<option value="active">Active</option>
						<option value="deactivated">Deactivated</option>
					</select>
				</div>
				<div class="field">
					<label for="f-from">Created from</label>
					<input type="date" id="f-from" />
				</div>
				<div class="field">
					<label for="f-to">Created to</label>
					<input type="date" id="f-to" />
				</div>
				<button type="button" class="clear" id="f-clear" hidden>Clear filters</button>
			</form>
			<div class="table-wrap" id="table-wrap">
				<table>
					<caption class="visually-hidden">Albums and how each one was created</caption>
					<thead>
						<tr>
							<th scope="col" class="col-cover">
								<span class="visually-hidden">Cover</span>
							</th>
							<th scope="col">Title</th>
							<th scope="col" class="col-cats">Categories</th>
							<th scope="col" class="num" id="th-photos" aria-sort="none">
									<button type="button" class="sort" id="sort-photos" title="Sort by number of photos">
										Photos <span class="sort-arrow" aria-hidden="true"></span>
									</button>
								</th>
							<th scope="col">Type</th>
							<th scope="col" class="col-status">Status</th>
							<th scope="col" class="col-created">Created</th>
							<th scope="col" class="col-actions">
								<span class="visually-hidden">Actions</span>
							</th>
						</tr>
					</thead>
					<tbody id="album-rows">
						{albums.map((album, index) => (
							<tr data-album-id={album.id} data-status={album.status} data-title={album.title} data-type={album.type} data-created={album.createdAt} data-photo-count={album.photos.length} data-order={index} class:list={{ off: album.status === 'deactivated' }}>
								<td class="col-cover">
									<img
										src={album.cover.thumb}
										alt=""
										width="56"
										height="56"
										loading="lazy"
										decoding="async"
									/>
								</td>
								<th scope="row" class="title">
									<span class="title-text">{album.title}</span>
									{/* Phones drop the Categories and Created columns and show them under the title instead. */}
									<span class="cats-inline">{namesOf(album.categoryIds).join(', ')}</span>
									<span class="status-inline" hidden={album.status !== 'deactivated'}>Deactivated</span>
									<span class="created-inline">
										<time datetime={album.createdAt} data-local-time>{createdText(album.createdAt)}</time>
									</span>
								</th>
								<td class="col-cats">
									{
										namesOf(album.categoryIds).length === 0 ? (
											<span class="none">No category</span>
										) : (
											<ul class="cats">
												{namesOf(album.categoryIds).map((name) => (
													<li class="cat">{name}</li>
												))}
											</ul>
										)
									}
								</td>
								<td class="num">{album.photos.length}</td>
								<td>
									<span class={`type type-${album.type}`}>{albumTypeLabels[album.type]}</span>
									{(() => {
										const at = expiryOf(album.photos);
										return at === null ? null : (
											<span class:list={['expiry', { gone: at <= now }]}>{at <= now ? 'Facebook links expired' : `Facebook links expire ${formatExpiry(at)}`}</span>
										);
									})()}
								</td>
								<td class="col-status">
									<span class={`state state-${album.status}`} data-state>{album.status === 'active' ? 'Active' : 'Deactivated'}</span>
								</td>
								<td class="col-created">
									<time datetime={album.createdAt} data-local-time>{createdText(album.createdAt)}</time>
								</td>
								<td class="col-actions">
									<div class="actions">
										<a href={`/admin/albums/${album.id}/edit`} class="edit" title="Edit" aria-label={`Edit ${album.title}`}>
											<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
												<path d="M3 17.25V21h3.75L17.8 9.94l-3.75-3.75L3 17.25zM20.7 7.04a1 1 0 000-1.41l-2.34-2.34a1 1 0 00-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" fill="currentColor" />
											</svg>
											<span class="edit-text">Edit</span>
										</a>
										<button type="button" class="toggle" data-toggle data-id={album.id} data-title={album.title} title={album.status === 'active' ? 'Deactivate' : 'Activate'} aria-label={`${album.status === 'active' ? 'Deactivate' : 'Activate'} ${album.title}`}>
											<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
												<path data-icon-on={'M6 19h4V5H6v14zm8-14v14h4V5h-4z'} data-icon-off={'M8 5v14l11-7L8 5z'} d={album.status === 'active' ? 'M6 19h4V5H6v14zm8-14v14h4V5h-4z' : 'M8 5v14l11-7L8 5z'} fill="currentColor" />
											</svg>
											<span class="toggle-text">{album.status === 'active' ? 'Deactivate' : 'Activate'}</span>
										</button>
										<button
											type="button"
											class="delete"
											data-delete
											data-id={album.id}
											data-title={album.title}
											data-photos={album.photos.length}
											data-stored={album.storedCount}
											aria-label={`Delete ${album.title}`}
											aria-disabled={album.status === 'active' ? 'true' : undefined}
											title={album.status === 'active' ? 'Deactivate the album first: only a deactivated album can be deleted' : 'Delete'}
										>
											<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
												<path d="M6 19a2 2 0 002 2h8a2 2 0 002-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" fill="currentColor" />
											</svg>
											<span class="delete-text">Delete</span>
										</button>
									</div>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<div id="albums-pager"></div>
			<p class="empty" id="no-match" hidden>No album matches these filters.</p>
			</>
		)
	}

	<dialog id="delete-dialog" class="dialog" aria-labelledby="delete-title" aria-describedby="delete-text">
		<h2 id="delete-title"></h2>
		<p class="dialog-text" id="delete-text"></p>
		<p class="dialog-note" id="delete-storage"></p>
		<p class="dialog-note">Likes and favorites of its photos are removed too. This cannot be undone.</p>
		<p class="dialog-error" id="delete-error" role="alert"></p>
		<div class="dialog-actions">
			<button type="button" class="dialog-btn ghost" id="delete-cancel" autofocus>Cancel</button>
			<button type="button" class="dialog-btn danger" id="delete-confirm">Delete album</button>
		</div>
	</dialog>
</AdminLayout>

<script>
	import { paginateElements } from '../../../scripts/pager';

	// ---- the time an album was created, in the viewer's own time zone
	const when = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
	document.querySelectorAll<HTMLTimeElement>('time[data-local-time]').forEach((el) => {
		const date = new Date(el.dateTime);
		if (!Number.isNaN(date.getTime())) el.textContent = when.format(date);
	});

	// ---- delete an album (after asking), together with its pictures on Cloudflare
	const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
	const dialog = $<HTMLDialogElement>('#delete-dialog');
	const dialogTitle = $('#delete-title');
	const dialogText = $('#delete-text');
	const dialogStorage = $('#delete-storage');
	const dialogError = $('#delete-error');
	const confirmButton = $<HTMLButtonElement>('#delete-confirm');
	const cancelButton = $<HTMLButtonElement>('#delete-cancel');
	const status = $('#list-status');
	const count = $('#album-count');

	const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
	// With a filter on, the count reads "2 of 7 albums" and only counts what is shown.
	const refreshCounts = () => {
		const rows = [...document.querySelectorAll<HTMLElement>('#album-rows tr')];
		const shown = rows.filter((r) => !r.hidden);
		const off = shown.filter((r) => r.dataset.status === 'deactivated').length;
		count.textContent = shown.length === rows.length ? plural(rows.length, 'album') : `${shown.length} of ${plural(rows.length, 'album')}`;
		$('#album-count-off').textContent = off > 0 ? ` · ${off} deactivated` : '';
	};

	// ---- search, filter and sort: the whole list is already on the page, so this needs no request
	const filters = document.querySelector<HTMLFormElement>('#album-filters');
	const rowsBody = document.querySelector<HTMLElement>('#album-rows');
	const sortButton = document.querySelector<HTMLButtonElement>('#sort-photos');
	const photosHeader = document.querySelector<HTMLElement>('#th-photos');
	const field = (id: string) => document.querySelector<HTMLInputElement & HTMLSelectElement>(`#${id}`)!;
	// Letters are compared without accents and case, so "ao dai" finds "Áo Dài".
	const plain = (text: string) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').toLowerCase();
	// The date a viewer sees in the Created column is in their own time zone, so the date filter uses it too.
	const localDay = (iso: string) => {
		const d = new Date(iso);
		return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
	};
	let sortDirection: 'none' | 'asc' | 'desc' = 'none';

	// The table is cut into pages after the filters: only the rows a filter lets through are counted.
	const pagerMount = document.querySelector<HTMLElement>('#albums-pager');
	const albumPager = pagerMount && rowsBody ? paginateElements(pagerMount, () => [...rowsBody.querySelectorAll<HTMLElement>('tr')], 'Albums') : null;

	const applyFilters = (resetPage = true) => {
		if (!filters || !rowsBody) return;
		const q = plain(field('f-search').value.trim());
		const type = field('f-type').value;
		const state = field('f-status').value;
		const from = field('f-from').value;
		const to = field('f-to').value;
		for (const row of rowsBody.querySelectorAll<HTMLElement>('tr')) {
			const day = localDay(row.dataset.created!);
			row.hidden = !((!q || plain(row.dataset.title ?? '').includes(q)) && (!type || row.dataset.type === type) && (!state || row.dataset.status === state) && (!from || day >= from) && (!to || day <= to));
		}
		const active = Boolean(q || type || state || from || to);
		$('#f-clear').hidden = !active;
		const total = rowsBody.querySelectorAll('tr').length;
		const shown = rowsBody.querySelectorAll('tr:not([hidden])').length;
		$('#table-wrap').hidden = total > 0 && shown === 0;
		$('#no-match').hidden = !(total > 0 && shown === 0);
		refreshCounts();
		albumPager?.refresh(resetPage);
	};

	const applySort = () => {
		if (!rowsBody || !sortButton || !photosHeader) return;
		const rows = [...rowsBody.querySelectorAll<HTMLElement>('tr')];
		const key = (r: HTMLElement) => Number(r.dataset.photoCount);
		const order = (r: HTMLElement) => Number(r.dataset.order);
		rows.sort((a, b) => (sortDirection === 'none' ? 0 : sortDirection === 'asc' ? key(a) - key(b) : key(b) - key(a)) || order(a) - order(b));
		rowsBody.append(...rows);
		albumPager?.refresh(true);
		photosHeader.setAttribute('aria-sort', sortDirection === 'none' ? 'none' : sortDirection === 'asc' ? 'ascending' : 'descending');
		sortButton.querySelector<HTMLElement>('.sort-arrow')!.textContent = sortDirection === 'asc' ? '▲' : sortDirection === 'desc' ? '▼' : '';
	};

	filters?.addEventListener('input', () => applyFilters());
	filters?.addEventListener('submit', (e) => e.preventDefault());
	$('#f-clear')?.addEventListener('click', () => {
		filters?.reset();
		applyFilters();
		field('f-search').focus();
	});
	// Most photos first, then fewest first, then back to the original order.
	sortButton?.addEventListener('click', () => {
		sortDirection = sortDirection === 'none' ? 'desc' : sortDirection === 'desc' ? 'asc' : 'none';
		applySort();
	});
	const say = (message: string, isError = false) => {
		status.textContent = message;
		status.classList.toggle('is-error', isError);
	};

	let pending: { id: string; title: string; row: HTMLTableRowElement; button: HTMLButtonElement } | null = null;

	// ---- activate / deactivate: one click, undone with one click, so no question is asked
	document.addEventListener('click', async (e) => {
		const toggle = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-toggle]');
		if (!toggle) return;
		const row = toggle.closest<HTMLTableRowElement>('tr')!;
		const title = toggle.dataset.title ?? '';
		const next = row.dataset.status === 'active' ? 'deactivated' : 'active';
		toggle.disabled = true;
		let response: Response | null = null;
		try {
			response = await fetch(`/api/admin/albums/${encodeURIComponent(toggle.dataset.id!)}/status`, {
				method: 'PUT',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ status: next }),
				credentials: 'same-origin',
			});
		} catch {
			// handled below
		}
		toggle.disabled = false;
		toggle.focus(); // a disabled button loses the focus: put it back where the person was
		if (!response?.ok) {
			const data = await response?.json().catch(() => null);
			say(response?.status === 404 ? `“${title}” no longer exists. Reload the page.` : (data?.error ?? `“${title}” could not be changed. Nothing was changed. Please try again.`), true);
			return;
		}
		const off = next === 'deactivated';
		row.dataset.status = next;
		row.classList.toggle('off', off);
		const state = row.querySelector<HTMLElement>('[data-state]')!;
		state.textContent = off ? 'Deactivated' : 'Active';
		state.className = `state state-${next}`;
		row.querySelector<HTMLElement>('.status-inline')!.hidden = !off;
		toggle.setAttribute('aria-label', `${off ? 'Activate' : 'Deactivate'} ${title}`);
		toggle.title = off ? 'Activate' : 'Deactivate';
		toggle.querySelector<HTMLElement>('.toggle-text')!.textContent = off ? 'Activate' : 'Deactivate';
		const icon = toggle.querySelector<SVGPathElement>('path')!;
		icon.setAttribute('d', icon.getAttribute(off ? 'data-icon-off' : 'data-icon-on')!);
		const del = row.querySelector<HTMLElement>('[data-delete]')!;
		if (off) {
			del.removeAttribute('aria-disabled');
			del.title = 'Delete';
		} else {
			del.setAttribute('aria-disabled', 'true');
			del.title = 'Deactivate the album first: only a deactivated album can be deleted';
		}
		applyFilters(false);
		if (row.hidden) field('f-status').focus(); // the row no longer matches the filter: keep the focus on the controls
		say(off ? `Album “${title}” was deactivated: it is no longer shown on the site, and its data is kept. You can activate it again, or delete it.` : `Album “${title}” is active again and shown on the site.`);
	});

	document.addEventListener('click', (e) => {
		const button = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-delete]');
		if (!button) return;
		// Only a deactivated album can be deleted (the server refuses as well).
		if (button.closest('tr')?.dataset.status !== 'deactivated') {
			say(`“${button.dataset.title}” is active. Deactivate it first: only a deactivated album can be deleted.`, true);
			return;
		}
		const photos = Number(button.dataset.photos ?? 0);
		const stored = Number(button.dataset.stored ?? 0);
		pending = { id: button.dataset.id!, title: button.dataset.title ?? '', row: button.closest('tr')!, button };
		dialogTitle.textContent = `Delete “${pending.title}”?`;
		dialogText.textContent = `This permanently deletes the album and its ${plural(photos, 'photo')}.`;
		dialogStorage.textContent =
			stored > 0
				? `${plural(stored, 'picture')} of it ${stored === 1 ? 'is' : 'are'} stored on Cloudflare and will be deleted from there as well (a picture that another album still uses is kept).`
				: 'None of its pictures are stored on Cloudflare (they are links to other sites), so nothing is deleted there.';
		dialogError.textContent = '';
		confirmButton.disabled = false;
		dialog.showModal();
	});

	cancelButton.addEventListener('click', () => dialog.close());
	dialog.addEventListener('click', (e) => {
		if (e.target === dialog) dialog.close();
	});

	// What the answer of the server means, in words.
	const describe = (title: string, r: { photos: number; stored: number; removedFromStorage: number; keptInStorage: number; notRemoved: string[]; storageUnavailable: boolean }) => {
		const parts = [`Album “${title}” was deleted (${plural(r.photos, 'photo')}).`];
		if (r.stored === 0) return { text: parts.join(' '), problem: false };
		if (r.removedFromStorage > 0) parts.push(`${plural(r.removedFromStorage, 'picture')} ${r.removedFromStorage === 1 ? 'was' : 'were'} also deleted from Cloudflare.`);
		if (r.keptInStorage > 0) parts.push(`${plural(r.keptInStorage, 'picture')} ${r.keptInStorage === 1 ? 'is' : 'are'} still used by another album, so ${r.keptInStorage === 1 ? 'it was' : 'they were'} kept.`);
		if (r.notRemoved.length > 0) {
			const names = r.notRemoved.slice(0, 5).join(', ') + (r.notRemoved.length > 5 ? ', …' : '');
			parts.push(
				r.storageUnavailable
					? `${plural(r.notRemoved.length, 'picture')} could not be deleted from Cloudflare because photo storage is not set up on this server. Delete ${r.notRemoved.length === 1 ? 'it' : 'them'} by hand in the Cloudflare dashboard: ${names}.`
					: `${plural(r.notRemoved.length, 'picture')} could not be deleted from Cloudflare (it may be unreachable or the key was refused). Delete ${r.notRemoved.length === 1 ? 'it' : 'them'} by hand in the Cloudflare dashboard: ${names}.`,
			);
		}
		return { text: parts.join(' '), problem: r.notRemoved.length > 0 };
	};

	confirmButton.addEventListener('click', async () => {
		if (!pending) return;
		const { id, title, row } = pending;
		confirmButton.disabled = true;
		cancelButton.disabled = true;
		dialogError.textContent = '';
		let response: Response | null = null;
		try {
			response = await fetch(`/api/admin/albums/${encodeURIComponent(id)}`, { method: 'DELETE', credentials: 'same-origin' });
		} catch {
			// handled below
		}
		cancelButton.disabled = false;
		if (!response || !response.ok) {
			const data = await response?.json().catch(() => null);
			confirmButton.disabled = false;
			// Keep the question open so it can be tried again; nothing was deleted.
			dialogError.textContent = response?.status === 404 ? 'This album no longer exists. Reload the page.' : (data?.error ?? 'The album could not be deleted. Nothing was changed. Please try again.');
			return;
		}
		const result = await response.json();
		dialog.close();

		// Take the row off the page and keep keyboard focus nearby.
		const shownRows = [...document.querySelectorAll<HTMLElement>('#album-rows tr:not([hidden]):not([data-off-page])')];
		const at = shownRows.indexOf(row);
		const next = (shownRows[at + 1] ?? shownRows[at - 1])?.querySelector<HTMLElement>('[data-delete]') ?? null;
		row.remove();
		const left = document.querySelectorAll('#album-rows tr').length;
		applyFilters(false);
		if (left === 0) {
			const empty = document.createElement('p');
			empty.className = 'empty';
			empty.id = 'empty';
			empty.textContent = 'No albums yet. Create the first one.';
			$('#table-wrap').replaceWith(empty);
		}
		const outcome = describe(title, result);
		say(outcome.text, outcome.problem);
		(next ?? status).focus();
		pending = null;
	});
	dialog.addEventListener('close', () => {
		if (pending && !confirmButton.disabled) pending.button.focus(); // closed without deleting: back to where it was
	});
</script>

<style>
	.toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		max-width: 1040px;
		margin: -8px 0 16px;
	}
	.summary {
		margin: 0;
		font-size: 14px;
		color: var(--muted);
	}
	.status {
		max-width: 1040px;
		min-height: 1.4em;
		margin: 0 0 10px;
		font-size: 14px;
		color: var(--muted);
		overflow-wrap: anywhere;
	}
	.status:empty {
		display: none;
	}
	.status.is-error {
		color: #c62828;
	}
	.status:focus {
		outline: 0;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		height: 40px;
		padding: 0 20px;
		border-radius: 999px;
		background: var(--text);
		color: #fff;
