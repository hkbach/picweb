---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AlbumForms from '../../../../components/AlbumForms.astro';
import { albumTypeLabels, getAlbum, listAlbumSources } from '../../../../server/repo.ts';

// Loaded by id on every request.
const album = /^\d+$/.test(Astro.params.id ?? '') ? getAlbum(Number(Astro.params.id)) : undefined;
if (!album) return new Response('Album not found', { status: 404 });

// Where the pictures were crawled from, in the order it happened (the history is kept when the album is edited).
const sources = listAlbumSources(album.id);
const when = (iso: string) => new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short' });
const initial = {
	id: album.id,
	title: album.title,
	categoryIds: album.categoryIds,
	coverIndex: Math.max(0, album.photos.findIndex((p) => p.id === album.cover.id)),
	photos: album.photos.map((p) => ({ url: p.src, alt: p.alt })),
};

// Rendered on demand so the middleware can require an administrator before anything is sent.
export const prerender = false;
---

<AdminLayout title={`Edit ${album.title}`} heading="Edit album">
	<a href="/admin/albums" class="back">← Back to albums</a>
	<p class="meta">
		Editing <strong>{album.title}</strong> · Type
		<span class={`type type-${album.type}`}>{albumTypeLabels[album.type]}</span>
		· Status <strong>{album.status === 'active' ? 'Active' : 'Deactivated'}</strong>
	</p>
	{album.status === 'deactivated' && <p class="note off">This album is deactivated, so it is hidden from the site. Activate it from the Albums list to show it again.</p>}
	<p class="note">
		An album keeps the type it was created with, so it is edited the same way: {
			album.type === 'crawling' ? 'by its image links.' : 'by its uploaded photos.'
		}
	</p>

	<section class="sources" aria-labelledby="sources-title">
		<h2 id="sources-title">Crawl history</h2>
		{
			sources.length === 0 ? (
				<p class="none">No crawl was used for this album: its pictures were added by hand.</p>
			) : (
				<>
					<p class="hint">The addresses crawled to collect this album&rsquo;s pictures. This is a record and does not change when the album is edited.</p>
					<ol class="source-list">
						{sources.map((s) => (
							<li>
								<span class={`kind kind-${s.kind}`}>{s.kind === 'facebook' ? 'Facebook' : 'Web'}</span>
								<a class="original" href={s.url} target="_blank" rel="noopener noreferrer nofollow">
									{s.url}
								</a>
								{s.finalUrl && (
									<span class="final">
										Led to{' '}
										<a href={s.finalUrl} target="_blank" rel="noopener noreferrer nofollow">
											{s.finalUrl}
										</a>
									</span>
								)}
								{s.title && <span class="page-title">{s.title}</span>}
								<span class="when">Crawled for this album on {when(s.createdAt)}</span>
							</li>
						))}
					</ol>
				</>
			)
		}
	</section>

	<AlbumForms mode="edit" type={album.type} album={initial} />
</AdminLayout>

<style>
	.sources {
		max-width: 720px;
		margin: 0 0 28px;
		padding: 16px 18px;
		border: 1px solid var(--border);
		border-radius: 12px;
	}
	.sources h2 {
		margin: 0 0 8px;
		font-size: 16px;
	}
	.sources .hint,
	.sources .none {
		margin: 0 0 10px;
		font-size: 13px;
		color: var(--muted);
	}
	.sources .none {
		margin: 0;
	}
	.source-list {
		display: grid;
		gap: 12px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.source-list li {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 3px;
		min-width: 0;
	}
	.source-list a {
		max-width: 100%;
		overflow-wrap: anywhere;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.source-list a:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 2px;
		border-radius: 2px;
	}
	.original {
		font-size: 14px;
		font-weight: 500;
	}
	.final,
	.page-title,
	.when {
		max-width: 100%;
		overflow-wrap: anywhere;
		font-size: 12px;
		color: var(--muted);
	}
	.kind {
		padding: 1px 8px;
		border-radius: 999px;
		background: var(--bg-soft);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.back {
		display: inline-block;
		margin: -8px 0 12px;
		font-size: 14px;
		color: var(--muted);
	}
	.back:hover {
		color: var(--text);
		text-decoration: underline;
	}
	.back:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 2px;
		border-radius: 4px;
	}
	.meta {
		margin: 0 0 4px;
		font-size: 15px;
	}
	.note {
		max-width: 720px;
		margin: 0 0 24px;
		font-size: 13px;
		color: var(--muted);
	}

	/* Same badges as the albums list. */
	.type {
		display: inline-block;
		margin-left: 4px;
		padding: 3px 10px;
		border-radius: 999px;
		font-size: 12px;
		font-weight: 600;
		white-space: nowrap;
	}
	.type-crawling {
		background: #e8f0fe;
		color: #1a4fb4;
	}
	.type-uploaded {
		background: #e6f4ea;
		color: #1b6b34;
	}
</style>
