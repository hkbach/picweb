---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { CLAIM_LABELS, CLAIM_STATUSES, claimTotals, listAllClaims, usd } from '../../server/claims.ts';

const claims = listAllClaims();
const totals = claimTotals();
const when = (iso: string) => new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC' }) + ' UTC';

// Rendered on demand so the middleware can require an administrator before anything is sent.
export const prerender = false;
---

<AdminLayout title="Credit claims" heading="Credit claims">
	<p class="intro">
		Requests from users to cash out their credits through PayPal. Send the money by hand to the PayPal address shown, then set the status to Paid.
		Rejecting a claim returns its credits to the user, and a rejected claim cannot be changed again.
	</p>

	<dl class="totals" aria-label="Totals">
		{
			CLAIM_STATUSES.map((s) => (
				<div>
					<dt>{CLAIM_LABELS[s]}</dt>
					<dd id={`total-${s}`} data-count={totals[s].n} data-cents={totals[s].cents}>
						{totals[s].n} · {usd(totals[s].cents)}
					</dd>
				</div>
			))
		}
	</dl>

	{
		claims.length === 0 ? (
			<p class="empty" id="none">No one has claimed credits yet.</p>
		) : (
			<>
				<div class="filter">
					<label for="status-filter">Show</label>
					<select id="status-filter">
						<option value="">All claims</option>
						{CLAIM_STATUSES.map((s) => <option value={s}>{CLAIM_LABELS[s]}</option>)}
					</select>
				</div>
				<p class="status" id="page-status" role="status" tabindex="-1"></p>
				<div class="table-wrap">
					<table id="claims-table">
						<caption class="visually-hidden">Claims to cash out credits, newest first</caption>
						<thead>
							<tr>
								<th scope="col">Date</th>
								<th scope="col">User</th>
								<th scope="col">PayPal</th>
								<th scope="col" class="num">Credits</th>
								<th scope="col" class="num">Amount</th>
								<th scope="col">Status</th>
							</tr>
						</thead>
						<tbody id="claim-rows">
							{
								claims.map((c) => (
									<tr data-claim-id={c.id} data-status={c.status} data-cents={c.usdCents}>
										<td class="when">{when(c.createdAt)}</td>
										<th scope="row" class="user">
											<span class="name">{c.userName}</span>
											<span class="email">{c.userEmail}{c.userId === null ? ' (account deleted)' : ''}</span>
										</th>
										<td class="paypal">{c.paypal}</td>
										<td class="num">{c.credits.toLocaleString('en-US')}</td>
										<td class="num">{usd(c.usdCents)}</td>
										<td class="state">
											<select class={`state-select s-${c.status}`} data-status-select aria-label={`Status of the claim by ${c.userName}`} disabled={c.status === 'rejected'} data-previous={c.status}>
												{CLAIM_STATUSES.map((s) => (
													<option value={s} selected={s === c.status}>
														{CLAIM_LABELS[s]}
													</option>
												))}
											</select>
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
				<div id="claims-pager"></div>
				<p class="empty" id="no-match" hidden>No claim has this status.</p>
			</>
		)
	}
</AdminLayout>

<script>
	import { paginateElements } from '../../scripts/pager';

	const body = document.querySelector<HTMLElement>('#claim-rows');
	if (body) {
		const filter = document.querySelector<HTMLSelectElement>('#status-filter')!;
		const say = document.querySelector<HTMLElement>('#page-status')!;
		const noMatch = document.querySelector<HTMLElement>('#no-match')!;
		const wrap = document.querySelector<HTMLElement>('.table-wrap')!;
		const usd = (cents: number) => `$${(cents / 100).toFixed(2)}`;
		const LABEL: Record<string, string> = { processing: 'Processing', paid: 'Paid', rejected: 'Rejected' };

		const claimsPager = paginateElements(document.querySelector<HTMLElement>('#claims-pager')!, () => [...body.querySelectorAll<HTMLElement>('tr')], 'Credit claims');
		const applyFilter = (resetPage = true) => {
			let shown = 0;
			for (const row of body.querySelectorAll<HTMLElement>('tr')) {
				row.hidden = filter.value !== '' && row.dataset.status !== filter.value;
				if (!row.hidden) shown++;
			}
			wrap.hidden = shown === 0;
			noMatch.hidden = shown !== 0;
			claimsPager.refresh(resetPage);
		};
		filter.addEventListener('change', () => applyFilter());

		// The totals above the table follow the rows on the page.
		const recount = () => {
			for (const s of ['processing', 'paid', 'rejected']) {
				const rows = [...body.querySelectorAll<HTMLElement>(`tr[data-status="${s}"]`)];
				const cents = rows.reduce((sum, r) => sum + Number(r.dataset.cents), 0);
				const cell = document.querySelector<HTMLElement>(`#total-${s}`)!;
				cell.dataset.count = String(rows.length);
				cell.dataset.cents = String(cents);
				cell.textContent = `${rows.length} · ${usd(cents)}`;
			}
		};

		body.addEventListener('change', async (e) => {
			const select = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-status-select]');
			if (!select) return;
			const row = select.closest<HTMLElement>('tr')!;
			const previous = select.dataset.previous!;
			const next = select.value;
			const who = row.querySelector('.name')?.textContent ?? 'the user';
			if (next === 'rejected' && !window.confirm(`Reject this claim by ${who} (${row.children[4].textContent})?\n\nTheir ${row.children[3].textContent} credits are returned to them, and a rejected claim cannot be changed again.`)) {
				select.value = previous;
				return;
			}
			select.disabled = true;
			let ok = false;
			let message = '';
			try {
				const response = await fetch(`/api/admin/claims/${encodeURIComponent(row.dataset.claimId!)}`, {
					method: 'PATCH',
					headers: { 'content-type': 'application/json' },
					credentials: 'same-origin',
					body: JSON.stringify({ status: next }),
				});
				const data = await response.json().catch(() => null);
				ok = response.ok;
				message = ok ? '' : typeof data?.error === 'string' ? data.error : 'The status could not be changed. Nothing was changed.';
			} catch {
				message = 'The server could not be reached. Nothing was changed.';
			}
			if (!ok) {
				select.value = previous;
				select.disabled = previous === 'rejected';
				say.textContent = message;
				say.classList.add('is-error');
				return;
			}
			row.dataset.status = next;
			select.dataset.previous = next;
			select.className = `state-select s-${next}`;
			select.disabled = next === 'rejected'; // a rejected claim is final
			say.classList.remove('is-error');
			say.textContent = next === 'rejected' ? `Claim by ${who} rejected: the credits were returned.` : `Claim by ${who} is now ${LABEL[next]}.`;
			recount();
			applyFilter(false);
		});
	}
</script>

<style>
	.intro {
		max-width: 720px;
		margin: -8px 0 16px;
		font-size: 14px;
		color: var(--muted);
	}
	.totals {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		max-width: 1040px;
		margin: 0 0 20px;
	}
	.totals div {
		min-width: 150px;
		padding: 12px 16px;
		border: 1px solid var(--border);
		border-radius: 12px;
	}
	.totals dt {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.totals dd {
		margin: 4px 0 0;
		font-size: 20px;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}
	.filter {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 12px;
		font-size: 14px;
	}
	.filter label {
		color: var(--muted);
		font-weight: 500;
	}
	select {
		height: 36px;
		padding: 0 10px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: #fff;
		color: var(--text);
		font: inherit;
		font-size: 14px;
	}
	select:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 1px;
	}
	select:disabled {
		opacity: 0.7;
	}
	.status {
		min-height: 1.4em;
		margin: 0 0 10px;
		font-size: 14px;
		color: var(--muted);
		overflow-wrap: anywhere;
	}
	.status.is-error {
		color: #c62828;
	}
	.status:focus {
		outline: 0;
	}
	.empty {
		color: var(--muted);
	}
	.table-wrap[hidden],
	.empty[hidden],
	tr[hidden] {
		display: none;
	}
	.table-wrap {
		max-width: 1040px;
		overflow-x: auto;
		border: 1px solid var(--border);
		border-radius: 12px;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 14px;
	}
	th,
	td {
		padding: 10px 16px;
		text-align: left;
		vertical-align: middle;
	}
	thead th {
		background: #fafafa;
		border-bottom: 1px solid var(--border);
		color: var(--muted);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		white-space: nowrap;
	}
	tbody tr + tr > * {
		border-top: 1px solid var(--bg-soft);
	}
	.num {
		text-align: right;
		font-variant-numeric: tabular-nums;
	}
	.when {
		font-size: 13px;
		color: var(--muted);
		white-space: nowrap;
	}
	.user .name,
	.user .email {
		display: block;
		overflow-wrap: anywhere;
	}
	.user .name {
		font-weight: 600;
	}
	.user .email {
		font-size: 12px;
		font-weight: 400;
		color: var(--muted);
	}
	.paypal {
		min-width: 190px;
		overflow-wrap: anywhere;
		font-weight: 500;
	}
	.state-select.s-paid {
		border-color: #1b6b34;
		color: #1b6b34;
	}
	.state-select.s-rejected {
		border-color: #c62828;
		color: #c62828;
	}
	@media (max-width: 700px) {
		th,
		td {
			padding: 8px 10px;
		}
	}
</style>
