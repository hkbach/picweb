---
// The "Referral credits" tab of User management: how many credits each of the three events is worth.
import { CREDIT_LIMITS, creditTotals, getCreditSettings } from '../server/credits.ts';

const settings = getCreditSettings();
const totals = creditTotals();
const { points, albumsPerCredit, creditsPerUsd } = CREDIT_LIMITS;
---

<section class="credits" aria-labelledby="credits-title" data-limits={JSON.stringify(CREDIT_LIMITS)}>
	<h2 id="credits-title">Referral credits</h2>
	<p class="lead">
		Every user has an invitation link. Set how many credits each event is worth, and what a credit is worth in dollars. A change applies to what happens from now on: credits that were already
		given are not recalculated.
	</p>

	<form id="credits-form" class="form" novalidate>
		<div class="rule">
			<label for="c-signup">1. A user registers</label>
			<p class="hint" id="c-signup-hint">Credits the new user gets when their account is created.</p>
			<input id="c-signup" name="signup" type="number" inputmode="numeric" min={points.min} max={points.max} step="1" value={settings.signup} aria-describedby="c-signup-hint" />
		</div>
		<div class="rule">
			<label for="c-friend">2. A friend registers through the user's link</label>
			<p class="hint" id="c-friend-hint">Credits the person who invited them gets, once, when the friend's account is created.</p>
			<input id="c-friend" name="referralSignup" type="number" inputmode="numeric" min={points.min} max={points.max} step="1" value={settings.referralSignup} aria-describedby="c-friend-hint" />
		</div>
		<div class="rule">
			<label for="c-albums">3. The invited friend opens albums</label>
			<p class="hint" id="c-albums-hint">
				Credits the inviter gets each time the friend has opened another batch of different albums to look at the photos (an album counts once).
			</p>
			<div class="pair">
				<input id="c-albums" name="referralAlbums" type="number" inputmode="numeric" min={points.min} max={points.max} step="1" value={settings.referralAlbums} aria-describedby="c-albums-hint" aria-label="Credits for each batch" />
				<span class="per">credit(s) for every</span>
				<input id="c-per" name="albumsPerCredit" type="number" inputmode="numeric" min={albumsPerCredit.min} max={albumsPerCredit.max} step="1" value={settings.albumsPerCredit} aria-label="Albums in a batch" />
				<span class="per">albums</span>
			</div>
		</div>

		<div class="rule">
			<label for="c-usd">4. Cashing out: credits worth 1 USD</label>
			<p class="hint" id="c-usd-hint">
				A user whose balance reaches this many credits can claim 1 USD through PayPal; a claim takes as many whole dollars as the balance allows. A claim keeps the rate it was made at.
			</p>
			<div class="pair">
				<input id="c-usd" name="creditsPerUsd" type="number" inputmode="numeric" min={creditsPerUsd.min} max={creditsPerUsd.max} step="1" value={settings.creditsPerUsd} aria-describedby="c-usd-hint" />
				<span class="per">credits = 1 USD</span>
			</div>
		</div>

		<p class="error" id="credits-error" role="alert"></p>
		<div class="actions">
			<button type="submit" class="save" id="credits-save">Save</button>
			<p class="saved" id="credits-saved" role="status"></p>
		</div>
	</form>

	<p class="totals" id="credits-totals">{totals.creditsGiven.toLocaleString('en-US')} credits given so far · {totals.invitedUsers.toLocaleString('en-US')} user{totals.invitedUsers === 1 ? '' : 's'} joined through a link</p>
</section>

<script>
	const form = document.querySelector<HTMLFormElement>('#credits-form');
	if (form) {
		const error = document.querySelector<HTMLElement>('#credits-error')!;
		const saved = document.querySelector<HTMLElement>('#credits-saved')!;
		const save = document.querySelector<HTMLButtonElement>('#credits-save')!;
		const totals = document.querySelector<HTMLElement>('#credits-totals')!;
		const fields = ['signup', 'referralSignup', 'referralAlbums', 'albumsPerCredit', 'creditsPerUsd'] as const;
		const input = (name: string) => form.elements.namedItem(name) as HTMLInputElement;

		// Whole numbers in range only; the server checks again.
		const problem = (): { name: string; message: string } | null => {
			for (const name of fields) {
				const el = input(name);
				const value = el.value.trim();
				const min = Number(el.min);
				const max = Number(el.max);
				if (value === '' || !/^\d+$/.test(value) || Number(value) < min || Number(value) > max) return { name, message: `Enter a whole number from ${min} to ${max}.` };
			}
			return null;
		};
		const mark = (invalidName: string | null) => fields.forEach((n) => input(n).setAttribute('aria-invalid', String(n === invalidName)));

		form.addEventListener('input', () => {
			saved.textContent = '';
			error.textContent = '';
			mark(null);
		});

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			saved.textContent = '';
			const bad = problem();
			if (bad) {
				error.textContent = bad.message;
				mark(bad.name);
				input(bad.name).focus();
				return;
			}
			error.textContent = '';
			mark(null);
			save.disabled = true;
			try {
				const response = await fetch('/api/admin/credits', {
					method: 'PUT',
					headers: { 'content-type': 'application/json' },
					credentials: 'same-origin',
					body: JSON.stringify(Object.fromEntries(fields.map((n) => [n, Number(input(n).value)]))),
				});
				const data = await response.json().catch(() => null);
				if (!response.ok) {
					error.textContent = typeof data?.error === 'string' ? data.error : 'The settings could not be saved. Nothing was changed.';
					return;
				}
				for (const n of fields) input(n).value = String(data.settings[n]);
				if (data.totals) totals.textContent = `${data.totals.creditsGiven.toLocaleString('en-US')} credits given so far · ${data.totals.invitedUsers.toLocaleString('en-US')} user${data.totals.invitedUsers === 1 ? '' : 's'} joined through a link`;
				saved.textContent = 'Saved. The new amounts apply from now on.';
			} catch {
				error.textContent = 'The server could not be reached. Nothing was changed.';
			} finally {
				save.disabled = false;
			}
		});
	}
</script>

<style>
	.credits {
		max-width: 720px;
	}
	.credits h2 {
		margin: 0 0 6px;
		font-size: 18px;
	}
	.lead {
		margin: 0 0 20px;
		font-size: 13px;
		color: var(--muted);
	}
	.form {
		display: grid;
		gap: 18px;
	}
	.rule {
		padding: 14px 16px;
		border: 1px solid var(--border);
		border-radius: 12px;
	}
	.rule label {
		font-size: 15px;
		font-weight: 600;
	}
	.hint {
		margin: 4px 0 10px;
		font-size: 13px;
		color: var(--muted);
	}
	.pair {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 10px;
	}
	.per {
		font-size: 14px;
		color: var(--muted);
	}
	input[type='number'] {
		width: 110px;
		height: 42px;
		padding: 0 12px;
		border: 1px solid var(--border);
		border-radius: 10px;
		font: inherit;
		font-variant-numeric: tabular-nums;
	}
	input[type='number']:focus {
		outline: 0;
		border-color: var(--text);
		box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.08);
	}
	input[aria-invalid='true'] {
		border-color: #c62828;
	}
	.error {
		margin: 0;
		min-height: 1.2em;
		font-size: 13px;
		color: #c62828;
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 14px;
	}
	.save {
		height: 44px;
		padding: 0 28px;
		border: 0;
		border-radius: 999px;
		background: var(--text);
		color: #fff;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.save:disabled {
		opacity: 0.6;
		cursor: default;
	}
	.save:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 2px;
	}
	.saved {
		margin: 0;
		font-size: 14px;
		color: #1b6b34;
	}
	.totals {
		margin: 22px 0 0;
		font-size: 13px;
		color: var(--muted);
	}
</style>
